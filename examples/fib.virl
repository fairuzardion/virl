// fib.virl
// Demonstrates functions, recursion, if/else, and return values.

fn fib(n) {
    if n <= 1 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

fn factorial(n) {
    let result = 1;
    let i = 2;
    while i <= n {
        result = result * i;
        i = i + 1;
    }
    return result;
}

fn main() {
    print("Fibonacci numbers:");
    for i in range(0, 10) {
        print(fib(i));
    }

    print("Factorials:");
    for i in range(1, 6) {
        print(factorial(i));
    }
}
